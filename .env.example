# =============================================================================
# Demi Studio — 環境變數範本（選用）
# =============================================================================
#
# 重要：SEO／官網網址／IG／FB／LINE 已寫死在程式內（src/content/site.ts、
# brand.ts、index.html、robots.txt、sitemap.xml），會隨 Git 部署到 Vercel。
# 就算雲端沒有 .env，正式站 SEO 與社群連結仍會正常。
#
# 本檔用途：
#   - 本機覆寫預設值（可選）
#   - 機密／不公開設定（GA、Google 表單 entry、Search Console 驗證碼）
#
# 使用：複製為 .env → 只填你需要覆寫或機密的項目 → 重啟 dev server
# =============================================================================

# -----------------------------------------------------------------------------
# 覆寫用（可留空＝使用程式內建正式值）
# -----------------------------------------------------------------------------
VITE_SITE_NAME=
VITE_SITE_URL=
VITE_INSTAGRAM_URL=
VITE_FACEBOOK_URL=
VITE_LINE_URL=
VITE_GOOGLE_MAP_URL=

# -----------------------------------------------------------------------------
# 機密／選用（建議只放本機 .env 或 Vercel Environment Variables）
# -----------------------------------------------------------------------------

# Google Analytics 4（例：G-XXXXXXXXXX）；留空＝不載入
VITE_GA_ID=

# Google Search Console 驗證碼（meta content）；留空＝不輸出
VITE_GOOGLE_SITE_VERIFICATION=

# 聯絡表單 → Google Forms（未設定則表單無法送出；與 SEO 無關）
# ACTION：把 /viewform 改成 /formResponse
VITE_GOOGLE_FORM_ACTION=
VITE_GOOGLE_FORM_ENTRY_NAME=
VITE_GOOGLE_FORM_ENTRY_PHONE=
VITE_GOOGLE_FORM_ENTRY_EMAIL=
VITE_GOOGLE_FORM_ENTRY_TYPE=
VITE_GOOGLE_FORM_ENTRY_DATE=
VITE_GOOGLE_FORM_ENTRY_MESSAGE=

# -----------------------------------------------------------------------------
# AI Commerce Platform — 既有網站 Widget（本機／選用；勿提交密鑰）
# 僅公開金鑰 pub_*；不要放 merchantId、JWT、DB 密碼
# -----------------------------------------------------------------------------
# 攝影商家 Web channel 公開金鑰（seed：pub_photo_web_seed_demo_key_001；或 Admin 複製）
VITE_ACA_TENANT_KEY=
# Commerce API
VITE_ACA_API_BASE=http://localhost:3000
# chat-widget.js（Commerce Widget dev server，預設 5174）
VITE_ACA_WIDGET_SRC=http://localhost:5174/chat-widget.js
