{
  "name": "photography-brand",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build && node scripts/generate-sitemap.mjs",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "images": "node scripts/process-images.mjs",
    "logo": "node scripts/logo-variants.mjs && node scripts/app-icon.mjs && node scripts/og-image.mjs",
    "start": "node server/start.ts"
  },
  "dependencies": {
    "pinia": "^2.2.6",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.0.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "sharp": "^0.35.2",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.3",
    "vite": "^6.0.5",
    "vue-tsc": "^2.1.10"
  }
}
